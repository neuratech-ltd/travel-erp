// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// Aligned to the frontend's Invoice / SalesReportRow / Employee interfaces.
// Nested Tour Package objects (passportInfo, ticketInfo, accommodation,
// transport, visaInfo, medicalInfo, billing) are Prisma "composite types" —
// MongoDB's native way to store embedded documents. They live inside the
// Invoice document itself, not as separate collections, which matches how
// your TS interface already nests them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum InvoiceType {
  AIR_TICKET
  NON_COMMISSION
  REISSUE
  TOUR_PACKAGE
  HOTEL
  VISA
}

enum InvoiceStatus {
  PAID
  UNPAID
  PARTIAL
}

enum PaymentMethod {
  CASH
  BANK
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

/**
 * ------------------------------------------------------------------
 */
/**
 * AUTH
 */
/**
 * ------------------------------------------------------------------
 */
model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * ------------------------------------------------------------------
 */
/**
 * REFERENCE DATA
 */
/**
 * ------------------------------------------------------------------
 */
model Client {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  email          String   @unique
  passportNumber String?
  phone          String?
  address        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  invoices Invoice[]
}

model Employee {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  email       String         @unique
  designation String?
  department  String?
  phone       String?
  joiningDate DateTime       @default(now())
  status      EmployeeStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  invoicesSold Invoice[]
}

model Agent {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  commissionRate Float?
  email          String   @unique
  phone          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  invoices Invoice[]
}

model Vendor {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  email          String   @unique
  iataCode       String?
  netOutstanding Float?   @default(0)
  phone          String?
  address        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  invoices Invoice[]
}

type PassportInfo {
  passportNo   String?
  paxName      String?
  paxType      String?
  nationalId   String?
  contactNo    String?
  email        String?
  dob          DateTime?
  dateOfIssue  DateTime?
  dateOfExpiry DateTime?
}

type TicketInfo {
  ticketNo    String?
  pnr         String?
  route       String?
  journeyDate DateTime?
  returnDate  DateTime?
  airline     String?
  salePrice   Float?
  costPrice   Float?
  profit      Float?
  vendor      String?
}

type Accommodation {
  hotelName     String?
  hotelLocation String?
  roomType      String?
  checkIn       DateTime?
  checkOut      DateTime?
  nights        Int?
  salePrice     Float?
  costPrice     Float?
  profit        Float?
  vendor        String?
}

type Transport {
  transportType String?
  referenceNo   String?
  description   String?
  fromDate      DateTime?
  toDate        DateTime?
  pickupTime    String?
  dropoffTime   String?
  salePrice     Float?
  costPrice     Float?
  profit        Float?
  vendor        String?
}

type VisaInfo {
  visaCategory     String?
  country          String?
  visaType         String?
  visaDeliveryDate DateTime?
  visaNo           String?
  salePrice        Float?
  costPrice        Float?
  profit           Float?
}

type MedicalInfo {
  hospitalName      String?
  doctorName        String?
  appointmentDate   DateTime?
  treatmentCategory String?
  companionName     String?
  ambulanceRequired Boolean?
  treatmentCost     Float?
  salePrice         Float?
  costPrice         Float?
  profit            Float?
}

type Billing {
  unitPrice       Float?
  costPrice       Float?
  billingQty      Int?
  discount        Float?
  extraFee        Float?
  totalCost       Float?
  totalProfit     Float?
  subTotal        Float?
  netTotal        Float?
  agentCommission Float?
}

model Invoice {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  invoiceNo String        @unique
  status    InvoiceStatus @default(UNPAID)
  type      InvoiceType
  salesDate DateTime
  dueDate   DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // relation FKs — replace clientName / salesBy strings from the TS interface
  clientId   String   @db.ObjectId
  client     Client   @relation(fields: [clientId], references: [id])
  employeeId String   @db.ObjectId
  employee   Employee @relation(fields: [employeeId], references: [id])
  agentId    String?  @db.ObjectId
  agent      Agent?   @relation(fields: [agentId], references: [id])
  vendorId   String?  @db.ObjectId // set when `airline` below maps to a known Vendor
  vendor     Vendor?  @relation(fields: [vendorId], references: [id])

  // --- Flat ticket fields (Air Ticket / Non Commission / Reissue) ---
  ticketNo    String?
  paxName     String?
  paxType     String?
  passportNo  String?
  contactNo   String?
  email       String?
  airline     String? // free-text fallback; vendorId is the normalized link
  route       String?
  pnr         String?
  journeyDate DateTime?
  returnDate  DateTime?
  class       String?
  segment     String?

  // --- Flat financial fields ---
  grossFare     Float?
  baseFare      Float?
  commissionPct Float?
  commission    Float?
  tax           Float?
  purchasePrice Float?
  clientPrice   Float?
  netCommission Float?
  profit        Float?
  vat           Float?
  extraFee      Float?
  discount      Float?

  // --- Tour Package embedded sub-documents (composite types) ---
  passportInfo  PassportInfo?
  ticketInfo    TicketInfo?
  accommodation Accommodation?
  transport     Transport?
  visaInfo      VisaInfo?
  medicalInfo   MedicalInfo?
  billing       Billing?

  payments Payment[]

  @@index([clientId])
  @@index([employeeId])
  @@index([type, salesDate])
  @@index([status])
}

/**
 * ------------------------------------------------------------------
 */
/**
 * PAYMENT — atomic receipts, optionally rolled up into SalesReportRow
 */
/**
 * ------------------------------------------------------------------
 */
model Payment {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  amount       Float
  method       PaymentMethod
  bankChannel  String? // e.g. "BRAC", "Pubali", "DBBL"
  receivedDate DateTime
  remarks      String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  invoiceId String  @db.ObjectId
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([receivedDate])
}

/**
 * ------------------------------------------------------------------
 */
/**
 * SALES REPORT ROW — kept as its own model, matching your TS type
 */
/**
 * exactly. Manually entered; not derived from Invoice/Payment.
 */
/**
 * ------------------------------------------------------------------
 */
model SalesReportRow {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  date        DateTime
  invoiceNo   String
  ticketType  String // "Int:" | "Domestic"
  ticketCount Int
  mrNo        String?
  salesRef    String?

  ticketReissue  Float @default(0)
  admaVoidCharge Float @default(0)
  visaAppFee     Float @default(0)
  hotelBooking   Float @default(0)
  ticket         Float @default(0)
  totalSales     Float // = sum of the five fields above, computed server-side

  receivedDate  DateTime?
  cash          Float     @default(0)
  bankBrac      Float     @default(0)
  bankPubali    Float     @default(0)
  bankDbbl      Float     @default(0)
  totalReceived Float // = sum of cash/bank fields, computed server-side
  dueAmount     Float // = totalSales - totalReceived, computed server-side

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([invoiceNo])
  @@index([salesRef])
}
