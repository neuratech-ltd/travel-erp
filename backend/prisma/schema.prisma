// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// Aligned to the frontend's Invoice / SalesReportRow / Employee interfaces.
// Nested Tour Package objects (passportInfo, ticketInfo, accommodation,
// transport, visaInfo, medicalInfo, billing) are Prisma "composite types" —
// MongoDB's native way to store embedded documents. They live inside the
// Invoice document itself, not as separate collections, which matches how
// your TS interface already nests them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum InvoiceType {
  AIR_TICKET
  NON_COMMISSION
  REISSUE
  TOUR_PACKAGE
  HOTEL
  VISA
}

model Counter {
  id    String @id @map("_id")
  value Int    @default(0)
}

enum InvoiceStatus {
  PAID
  UNPAID
  PARTIAL
}

enum PaymentMethod {
  CASH
  BANK
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

/**
 * ------------------------------------------------------------------
 */
/**
 * AUTH
 */
/**
 * ------------------------------------------------------------------
 */
model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * ------------------------------------------------------------------
 */
/**
 * REFERENCE DATA
 */
/**
 * ------------------------------------------------------------------
 */
model Client {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  email          String   @unique
  passportNumber String?
  phone          String?
  address        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  invoices Invoice[]
}

model Employee {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  email       String         @unique
  designation String?
  department  String?
  phone       String?
  joiningDate DateTime       @default(now())
  status      EmployeeStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  invoicesSold Invoice[]
}

model Agent {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  commissionRate Float?
  email          String   @unique
  phone          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  invoices Invoice[]
}

model Vendor {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  email          String   @unique
  iataCode       String?
  netOutstanding Float?   @default(0)
  phone          String?
  address        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  invoices Invoice[]
}

type PassportInfo {
  passportNo   String?
  paxName      String?
  paxType      String?
  nationalId   String?
  contactNo    String?
  email        String?
  dob          DateTime?
  dateOfIssue  DateTime?
  dateOfExpiry DateTime?
}

type TicketInfo {
  ticketNo    String?
  pnr         String?
  route       String?
  journeyDate DateTime?
  returnDate  DateTime?
  airline     String?
  salePrice   Float?
  costPrice   Float?
  profit      Float?
  vendor      String?
}

type Accommodation {
  hotelName     String?
  hotelLocation String?
  roomType      String?
  checkIn       DateTime?
  checkOut      DateTime?
  nights        Int?
  salePrice     Float?
  costPrice     Float?
  profit        Float?
  vendor        String?
}

type Transport {
  transportType String?
  referenceNo   String?
  description   String?
  fromDate      DateTime?
  toDate        DateTime?
  pickupTime    String?
  dropoffTime   String?
  salePrice     Float?
  costPrice     Float?
  profit        Float?
  vendor        String?
}

type VisaInfo {
  visaCategory     String?
  country          String?
  visaType         String?
  visaDeliveryDate DateTime?
  visaNo           String?
  salePrice        Float?
  costPrice        Float?
  profit           Float?
}

type MedicalInfo {
  hospitalName      String?
  doctorName        String?
  appointmentDate   DateTime?
  treatmentCategory String?
  companionName     String?
  ambulanceRequired Boolean?
  treatmentCost     Float?
  salePrice         Float?
  costPrice         Float?
  profit            Float?
}

type Billing {
  unitPrice       Float?
  costPrice       Float?
  billingQty      Int?
  discount        Float?
  extraFee        Float?
  totalCost       Float?
  totalProfit     Float?
  subTotal        Float?
  netTotal        Float?
  agentCommission Float?
}

type Passenger {
  paxName            String
  paxType            String?
  passportNo         String?
  contactNo          String?
  email              String?
  dob                DateTime?
  passportIssueDate  DateTime?
  passportExpiryDate DateTime?

  ticketNo         String?
  pnr              String? // 6-digit, validated + uniqueness-checked in service layer
  route            String?
  class            String?
  segment          String?
  journeyDate      DateTime?
  returnDate       DateTime?
  ticketingRemarks String?

  baseFare             Float?
  taxesCommission      Float?
  aitTax               Float? // renamed from airTax — Advance Income Tax
  commissionPct        Float?
  calculatedCommission Float?
  purchaseCost         Float?
  netCommission        Float?
  clientPrice          Float?
  discount             Float?
  extraFee             Float?
  profit               Float?
}

model Invoice {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  invoiceNo String        @unique // now system-generated, never client input
  status    InvoiceStatus @default(UNPAID)
  type      InvoiceType
  issueDate DateTime // renamed from salesDate; dueDate removed entirely
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  clientId    String   @db.ObjectId
  client      Client   @relation(fields: [clientId], references: [id])
  referenceId String   @db.ObjectId // renamed from employeeId
  reference   Employee @relation(fields: [referenceId], references: [id]) // renamed from employee
  vendorId    String?  @db.ObjectId
  vendor      Vendor?  @relation(fields: [vendorId], references: [id])

  airline    String?
  passengers Passenger[]

  totalBaseFare        Float @default(0)
  totalTaxesCommission Float @default(0)
  totalAitTax          Float @default(0)
  totalCommission      Float @default(0)
  totalPurchaseCost    Float @default(0)
  totalClientPrice     Float @default(0)
  totalDiscount        Float @default(0)
  totalExtraFee        Float @default(0)
  totalProfit          Float @default(0)

  passportInfo  PassportInfo?
  ticketInfo    TicketInfo?
  accommodation Accommodation?
  transport     Transport?
  visaInfo      VisaInfo?
  medicalInfo   MedicalInfo?
  billing       Billing?

  payments Payment[]
  agent    Agent?    @relation(fields: [agentId], references: [id])
  agentId  String?   @db.ObjectId

  @@index([clientId])
  @@index([referenceId])
  @@index([type, issueDate])
  @@index([status])
}

/**
 * ------------------------------------------------------------------
 */
/**
 * PAYMENT — atomic receipts, optionally rolled up into SalesReportRow
 */
/**
 * ------------------------------------------------------------------
 */
model Payment {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  amount       Float
  method       PaymentMethod
  bankChannel  String? // e.g. "BRAC", "Pubali", "DBBL"
  receivedDate DateTime
  remarks      String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  invoiceId String  @db.ObjectId
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([receivedDate])
}

/**
 * ------------------------------------------------------------------
 */
/**
 * SALES REPORT ROW — kept as its own model, matching your TS type
 */
/**
 * exactly. Manually entered; not derived from Invoice/Payment.
 */
/**
 * ------------------------------------------------------------------
 */
model SalesReportRow {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  date        DateTime
  invoiceNo   String
  ticketType  String // "Int:" | "Domestic"
  ticketCount Int
  mrNo        String?
  salesRef    String?

  ticketReissue  Float @default(0)
  admaVoidCharge Float @default(0)
  visaAppFee     Float @default(0)
  hotelBooking   Float @default(0)
  ticket         Float @default(0)
  totalSales     Float // = sum of the five fields above, computed server-side

  receivedDate  DateTime?
  cash          Float     @default(0)
  bankBrac      Float     @default(0)
  bankPubali    Float     @default(0)
  bankDbbl      Float     @default(0)
  totalReceived Float // = sum of cash/bank fields, computed server-side
  dueAmount     Float // = totalSales - totalReceived, computed server-side

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([invoiceNo])
  @@index([salesRef])
}
